            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Seafood Dinner & Drinks\",\n  \"totalAmount\": 1200.00,\n  \"paidById\": 1,\n  \"splitType\": \"EQUAL\",\n  \"expenseDate\": \"2026-11-17\",\n  \"splits\": [\n    {\"userId\": 1},\n    {\"userId\": 2},\n    {\"userId\": 3}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/expenses/{{expenseId}}", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "{{expenseId}}"]}
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/api/expenses/{{expenseId}}", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "{{expenseId}}"]}
          }
        }
      ]
    },
    {
      "name": "4. Balances",
