              "raw": "{\n  \"paidById\": 2,\n  \"paidToId\": 1,\n  \"amount\": 300.00,\n  \"settlementDate\": \"2026-11-17\",\n  \"notes\": \"Paid ₹300 to Rahul via GPay\"\n}"
